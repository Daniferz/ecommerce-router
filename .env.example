# Copia este archivo a .env y rellena tus valores. NUNCA subas .env al repo.
# cp .env.example .env

# Clave de Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Modelo a usar
MODELO=gemini-3.5-flash-lite

# Base de datos Postgres para que la memoria del agente sobreviva a reinicios.
# Si falta o Postgres no responde, la API usa memoria en RAM (MemorySaver).
# Formato: postgresql://usuario:clave@host:5432/base
DATABASE_URL=postgresql://usuario:clave@localhost:5432/mi_base

# Clave para proteger POST /chat (se envía en la cabecera X-API-Key).
# Genera una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=clave-de-ejemplo-cambiame

# Token que da @BotFather al crear el bot. Vacío hasta el paso 5.
TELEGRAM_TOKEN=

# Secreto que Telegram envía en cada webhook (header
# X-Telegram-Bot-Api-Secret-Token) para que la API lo verifique.
TELEGRAM_SECRET=cambiame

# URL https pública (Heroku). Vacío hasta el paso de despliegue.
PUBLIC_URL=
